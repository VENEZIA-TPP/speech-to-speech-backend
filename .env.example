# Database
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=s2st_db
DATABASE_HOST=db
DATABASE_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/s2st_db

# Server
PORT=8000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ASR
ASR_MODEL=stub
ASR_DEVICE=cpu

# MT
MT_MODEL=stub
MT_DEVICE=cpu

# TTS
TTS_MODEL=stub
TTS_DEVICE=cpu

# Languages
SUPPORTED_LANGUAGE_PAIRS=es-en,en-es

# Audio processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_DURATION_MS=3000

# WebSocket
MAX_AUDIO_FRAME_BYTES=2000000