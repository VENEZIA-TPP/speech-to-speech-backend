# Database
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=s2st_db
DATABASE_HOST=db
DATABASE_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/s2st_db

# Server
PORT=8000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ASR
ASR_MODEL=stub
ASR_DEVICE=cpu

# MT
MT_MODEL=stub
MT_DEVICE=cpu

# TTS
TTS_MODEL=stub
TTS_DEVICE=cpu

# Languages
SUPPORTED_LANGUAGE_PAIRS=es-en,en-es

# Audio processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_DURATION_MS=3000

# WebSocket
MAX_AUDIO_FRAME_BYTES=2000000

# Voice activity detection
# El segmentador decide donde termina cada frase. Estos son el punto de partida,
# no valores calibrados contra hablantes reales: verificados contra voz
# sintetizada, que es mas limpia que una persona.
VAD_THRESHOLD=0.5
# El dial de latencia contra calidad, y el que mas conviene volver a medir. Por
# debajo de ~200 ms una pausa para respirar no se distingue del final de una
# oracion, y la traduccion recibe un fragmento roto. scripts/demo_vad.py
# --barrido compara valores sobre una grabacion propia.
VAD_MIN_SILENCE_MS=250
# Filtra rafagas de ruido. Se mide sobre habla real, no sobre el largo del
# segmento.
VAD_MIN_SPEECH_MS=384
# Pre-roll para no cortar el ataque de la primera silaba. No cuesta latencia:
# es audio ya capturado.
VAD_SPEECH_PAD_MS=300
# Finito a proposito: los workers se comparten entre sesiones, asi que un
# segmento sin techo es una llamada bloqueante sin techo sobre un recurso
# compartido.
VAD_MAX_SPEECH_MS=8000
# Cuanto mirar hacia atras al tocar el techo, para cortar en el frame mas
# silencioso en vez de a mitad de silaba.
VAD_CEILING_LOOKBACK_MS=400
